# Alpha Loop — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Required (all modes) ---
BIRDEYE_API_KEY=your_birdeye_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/alpha_loop

# --- Required for live mode only ---
SOLANA_PRIVATE_KEY=          # base58-encoded 64-byte keypair secret
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use Helius/Triton in production
